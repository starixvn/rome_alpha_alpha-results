@model Alpha.Results.ViewModels.TabViewModel

<li role="presentation" class="@((Model.SelectedTabName == "normal") ? "active" : string.Empty)"><a href="~/normal/">Normal</a></li>
<li role="presentation" class="@((Model.SelectedTabName == "outright") ? "active" : string.Empty)"><a href="~/outright/index">Outright</a></li>
@if (Model.IsEnabledKenoTab)
{
    <li role="presentation" class="@((Model.SelectedTabName == "keno") ? "active" : string.Empty)" ><a href="~/keno/index">Keno</a></li>
}
