
@model ResultRequest
@{
    Layout = null;
}

<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <title>@Html.Raw(ViewBag.ResultTitle)</title>

    <link href="~/Content/Fanex.Result/fanex.result.css" rel="stylesheet" />

    <link href="~/Content/Fanex.Result/fanex.result.css" rel="stylesheet" />
    <link href="/contents/css/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/contents/components/datetimepicker/css/bootstrap-datetimepicker.min.css" rel="stylesheet" />
    <link href="~/Content/result.css" rel="stylesheet" />

</head>
<body>
    <form id="frmmain" method="get">
        <div id="page_main">
            <div id="page_main">
                <div class="container-fluid">
                    <div class="">
                        <ul class="nav nav-tabs" role="tablist">
                            <li role="presentation" class="active"><a href="~/normal/">Normal</a></li>
                            <li role="presentation"><a href="~/outright/index">Outright</a></li>
                            <li role="presentation"><a href="~/keno/index" aria-controls="keno" role="tab" data-toggle="tab">Keno</a></li>
                        </ul>
                        <div class="tab-content">
                            <div role="tabpanel" class="tab-pane active" id="normal">
                                <div class="row filter">
                                    <div class="col-sm-12">
                                        <span class="txt">From</span>
                                        <div class="control">
                                            <div class="input-group date" id="datetimepicker1">
                                                <input type="text" class="form-control" />
                                                <span class="input-group-addon">
                                                    <span class="calendar"></span>
                                                </span>
                                            </div>
                                        </div>
                                        <input type="button" value="12/23/2015" class="btn btn-default" />
                                        <input type="button" value="12/22/2015" class="btn btn-default" />
                                        <input type="button" value="Submit" class="btn btn-submit" />
                                    </div>
                                    <div class="col-sm-12">
                                        <span class="txt-red">*</span> You can view report data from 12/20/2015
                                    </div>
                                    <div class="col-sm-12 sport-info">
                                        <span class="txt">Sport</span>
                                        <div class="dropdown control">
                                            <button class="btn btn-default dropdown-toggle" type="button" id="dropdownMenu1" data-toggle="dropdown" aria-haspopup="true" aria-expanded="true">
                                                Soccer
                                                <span class="caret"></span>
                                            </button>
                                            <ul class="dropdown-menu" aria-labelledby="dropdownMenu1">
                                                <li><a href="#">Basketball</a></li>
                                                <li><a href="#">Tennis</a></li>
                                                <li><a href="#">Volley ball</a></li>
                                            </ul>
                                        </div>
                                        <span class="txt">League</span>
                                        <div class="dropdown control league-content">
                                            <button class="btn btn-default dropdown-toggle" type="button" id="dropdownMenu1" data-toggle="dropdown" aria-haspopup="true" aria-expanded="true">
                                                *...* Show All League *...*
                                                <span class="caret"></span>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                                <div class="main-content">
                                    <div class="fn-rs-content-header">
                                        <table class="fn-rs">
                                            <thead>
                                                <tr class="header">
                                                    <th class="cl-ko-time">Kick Off. Time</th>
                                                    <th class="cl-match home ">Match</th>
                                                    <th class="cl-ht-score">HT Score</th>
                                                    <th class="cl-f-score">Final Score</th>
                                                    <th class="cl-status ">Status</th>
                                                </tr>
                                            </thead>
                                        </table>
                                    </div>
                                    <div class="fn-rs-content-scroll">
                                        <table class="fn-rs">
                                            <tbody>
                                                <tr class="data">
                                                    <td colspan="5" class="cl-league">Japan Empress women cup</td>
                                                </tr>
                                                <tr class="data odd">
                                                    <td rowspan="2" class="cl-ko-time">12/23/2015</td>
                                                    <td class="cl-match home">NTV Beleza(W)(N)</td>
                                                    <td class="cl-ht-score">1</td>
                                                    <td class="cl-f-score">-</td>
                                                    <td rowspan="2" class="cl-status ">Running</td>
                                                </tr>
                                                <tr class="data odd">
                                                    <td class="cl-match home">Albirex Niigata (W)</td>
                                                    <td class="cl-ht-score">1</td>
                                                    <td class="cl-f-score">-</td>
                                                </tr>
                                                <tr class="data">
                                                    <td colspan="5" class="cl-league">Japan Empress women cup-Corners</td>
                                                </tr>
                                                <tr class="data odd">
                                                    <td rowspan="2" class="cl-ko-time">12/23/2015</td>
                                                    <td class="cl-match home">NTV Beleza(W)(N)</td>
                                                    <td class="cl-ht-score">1</td>
                                                    <td class="cl-f-score">-</td>
                                                    <td rowspan="2" class="cl-status ">Completed</td>
                                                </tr>
                                                <tr class="data odd">
                                                    <td class="cl-match home">Albirex Niigata (W)</td>
                                                    <td class="cl-ht-score">1</td>
                                                    <td class="cl-f-score">-</td>
                                                </tr>
                                                <tr class="data even">
                                                    <td rowspan="2" class="cl-ko-time">12/23/2015</td>
                                                    <td class="cl-match home">NTV Beleza(W)(N)</td>
                                                    <td class="cl-ht-score">1</td>
                                                    <td class="cl-f-score">-</td>
                                                    <td rowspan="2" class="cl-status ">Completed</td>
                                                </tr>
                                                <tr class="data even">
                                                    <td class="cl-match home">Albirex Niigata (W)</td>
                                                    <td class="cl-ht-score">1</td>
                                                    <td class="cl-f-score">-</td>
                                                </tr>
                                                <tr class="data odd">
                                                    <td rowspan="2" class="cl-ko-time">12/23/2015</td>
                                                    <td class="cl-match home">NTV Beleza(W)(N)</td>
                                                    <td class="cl-ht-score">1</td>
                                                    <td class="cl-f-score">-</td>
                                                    <td rowspan="2" class="cl-status ">Completed</td>
                                                </tr>
                                                <tr class="data odd">
                                                    <td class="cl-match home">Albirex Niigata (W)</td>
                                                    <td class="cl-ht-score">1</td>
                                                    <td class="cl-f-score">-</td>
                                                </tr>
                                            </tbody>
                                        </table>

                                    </div>
                                </div>
                            </div>
                            <div role="tabpanel" class="tab-pane" id="outright">
                                <div class="row filter">
                                    <div class="col-sm-12">
                                        <span class="txt">From</span>
                                        <div class="control">
                                            <div class="input-group date" id="datetimepicker_from">
                                                <input type="text" class="form-control" />
                                                <span class="input-group-addon">
                                                    <span class="calendar"></span>
                                                </span>
                                            </div>
                                        </div>
                                        <span class="txt">To</span>
                                        <div class="control">
                                            <div class="input-group date" id="datetimepicker_to">
                                                <input type="text" class="form-control" />
                                                <span class="input-group-addon">
                                                    <span class="calendar"></span>
                                                </span>
                                            </div>
                                        </div>
                                        <input type="button" value="12/23/2015" class="btn btn-default" />
                                        <input type="button" value="12/22/2015" class="btn btn-default" />
                                        <input type="button" value="Submit" class="btn btn-submit" />
                                    </div>
                                    <div class="col-sm-12">
                                        <span class="txt-red">*</span> You can view report data from 12/20/2015
                                    </div>
                                </div>
                            </div>
                            <div role="tabpanel" class="tab-pane" id="keno"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <input type="hidden" id="isOutright" name="isOutright" value="@Model.IsOutright.ToString()" />
        @Html.Hidden("RootURL", Url.Content("~/"))
    </form>
    <script type="text/javascript" src="/contents/libs/jquery/jquery-1.11.3.min.js"></script>
    <script type="text/javascript" src="/contents/libs/moment/moment.js"></script>
    <script type="text/javascript" src="/contents/css/bootstrap/js/bootstrap.min.js"></script>
    <script type="text/javascript" src="/contents/components/datetimepicker/js/bootstrap-datetimepicker.min.js"></script>
    <script type="text/javascript">
    $(function () {
        $('#datetimepicker1').datetimepicker();
        $('#datetimepicker_from').datetimepicker();
        $('#datetimepicker_to').datetimepicker({
            useCurrent: false //Important! See issue #1075
        });
        $("#datetimepicker_from").on("dp.change", function (e) {
            $('#datetimepicker_from').data("DateTimePicker").minDate(e.date);
        });
        $("#datetimepicker_to").on("dp.change", function (e) {
            $('#datetimepicker_to').data("DateTimePicker").maxDate(e.date);
        });
    });
    </script>
</body>
</html>

