@{
    ViewBag.Title = Model.ProductName;
}

@model KenoResultViewModel

<div role="tabpanel" class="tab-pane active" id="keno">
    <div class="filter">
        <a href="@(Model.ResultUrl)" id="result-link" class="lnk" target="_blank">@Model.ResultLinkText</a>
        @Html.Hidden("extend-token-url", Model.ExtendTokenUrl)
    </div>
</div>

@section scripts
{
    @Scripts.Render(BundleConfig.KenoResultStyleBundleUrl)
}