<!DOCTYPE html>
<html class="ifr-result">
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@Html.Raw(ViewBag.Title)</title>
    @Alpha.Web.Helpers.StaticResources.AssetStyles.RenderWithRoleAndDarkMode("/bundles/site-results/")
    @Styles.Render($"~/bundle/styles/resultcore{Alpha.Results.Site.Helpers.DarkModeHelper.GetDarkModeName()}")
    @RenderSection("Styles", false)
    @Alpha.Web.Helpers.GoogleAnalyticHepler.GtagScript()
</head>
<body>
    @Alpha.Web.Helpers.GoogleAnalyticHepler.GtagNoScript()
    <div id="page_main">
        <div id="page_main">
            <div class="container-fluid">
                <div class="">
                    <ul class="nav nav-tabs" role="tablist">
                        @Html.Action("Index", "Tab", new { tabName = ViewContext.RouteData.Values["controller"], area = "" })
                    </ul>
                    <div class="tab-content">
                        @RenderBody()
                    </div>
                </div>
            </div>
        </div>
    </div>

    @Html.Hidden("RootURL", HttpContext.Current.Response.ApplyAppPathModifier("~/"))

    @Alpha.Web.Helpers.StaticResources.AssetScripts.Render("/bundles/site-results/default")
    @Alpha.Web.Helpers.StaticResources.AssetScripts.RenderCommon("/bundles/common/ajaxSetup")
    @RenderSection("Scripts", false)

    @Html.Raw(Fanex.Logging.LogManager.RenderJavascriptLogger())
</body>
</html>
