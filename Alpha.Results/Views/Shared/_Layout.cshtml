<!DOCTYPE html>
<html class="ifr-result">
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@Html.Raw(ViewBag.Title)</title>
    <link href="" rel="stylesheet" />
    @Alpha.Results.Site.Helpers.StaticResources.AssetStyles.Render("/bundles/site-results/default")
    
    @RenderSection("ComponentStyles", false)

    @Styles.Render(BundleConfig.ResultCoreStyleBundleUrl)

    @RenderSection("Styles", false)

</head>
<body>
    <div id="page_main">
        <div id="page_main">
            <div class="container-fluid">
                <div class="">
                    <ul class="nav nav-tabs" role="tablist">
                        @Html.Action("Index", "Tab", new { tabName = ViewContext.RouteData.Values["controller"], area = "" })
                    </ul>
                    <div class="tab-content">
                        @RenderBody()
                    </div>
                </div>
            </div>
        </div>
    </div>

    @Html.Hidden("RootURL", HttpContext.Current.Response.ApplyAppPathModifier("~/"))

    @Alpha.Results.Site.Helpers.StaticResources.AssetScripts.Render("/bundles/site-results/default")

    @RenderSection("Scripts", false)

    @Html.Partial("Piwik")
</body>
</html>


