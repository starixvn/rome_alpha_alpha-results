@model NormalDetailViewModel

@{
    ViewBag.Title = Model.Title;
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@Html.Raw(ViewBag.Title)</title>
    <link href="/contents/css/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/Fanex.Result/fanex.result.css" rel="stylesheet" />
    <link href="~/Content/result.css" rel="stylesheet" />
</head>
<body>
    <div class="container-fluid">

        @if (!Model.IsViewResultFromBetList)
        {
            <h5 id="detail-result-title">@Model.Title</h5>
        }

        <div class="detail-result" id="detail-result-body">
            @Html.Raw(Model.HtmlResults)
        </div>

    </div>

</body>
</html>


