@{
    ViewBag.Title = "Normal";
}

@model NormalViewModel


@section styles
{
    <link href="/contents/components/select2/css/select2.min.css" rel="stylesheet" />
}

<div role="tabpanel" class="tab-pane active" id="normal">
    <div class="row filter">
        @using (Html.BeginForm("Index", "Normal", FormMethod.Get, new { @id = "result-filter" }))
        {
            <div class="col-sm-12">
                <span class="txt">@ResultLang.date</span>
                <div class="control date">
                    <div class="input-group date" id="dpkContainer">
                        @Html.EditorFor(model => model.ResultDate, new { htmlAttributes = new { @class = "form-control" } })
                        <span class="input-group-addon">
                            <span class="calendar"></span>
                        </span>
                    </div>
                </div>

                <input type="submit" value="@Model.Today" id="today-results" class="btn btn-default btn-other-day" />
                <input type="submit" value="@Model.Yesterday" id="yesterday-results" class="btn btn-default btn-other-day" />
                <input type="submit" value="@ResultLang.submit" id="selected-day-results" class="btn btn-submit" />
            </div>

            <div class="col-sm-12">
                <span class="txt-red">*</span> @Model.MinResultDateMessage
            </div>

            if (Model.Sports.Any())
            {
                <div class="col-sm-12 sport-info">
                    <span class="txt">@ResultLang.sport</span>
                    <div class="dropdown control">
                        @Html.DropDownListFor(model => model.SportId, Model.Sports, new { @class = "form-control" })
                    </div>

                    <span class="txt">@ResultLang.league</span>
                    <div class="dropdown control league-content">
                        @Html.DropDownListFor(model => model.LeagueId, Model.Leagues, ResultLang.ShowAllLeagues, new { @class = "form-control", @onchange = "this.form.submit()" })
                    </div>
                    <span class="icon-excel" id="excel-btn"></span>
                </div>
            }
        }
    </div>

    <div class="main-content" id="main-result">
        @Html.Raw(Model.HtmlResults)
    </div>
    @Html.HiddenFor(model => model.MinResultDate)
</div>

<div class="modal fade" id="result-details" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">@ResultLang.result</h4>
        </div>

        <div class="modal-body" id="detail-result-body">
            <iframe src="about:blank" frameborder="0" width="100%" scrolling="yes" height="400px" id="result-detail-frm" name="result-detail-frm"></iframe>
        </div>
    </div>
    </div>
</div>

@section scripts
{
    <script type="text/javascript" src="/contents/components/select2/js/select2.min.js"></script>
    @Scripts.Render(BundleConfig.NormalResultJavascriptBundleUrl)
}

