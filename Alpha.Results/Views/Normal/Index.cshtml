@{
    ViewBag.Title = "Normal";
}

@model NormalResultViewModel

<div role="tabpanel" class="tab-pane active" id="normal">
    <div class="row filter">
        @using (Html.BeginForm("Index", "Normal", FormMethod.Get))
        {
            <div class="col-sm-12">
                <span class="txt">From</span>
                <div class="control">
                    <div class="input-group date" id="dpkContainer">
                        @Html.EditorFor(model => model.ResultDate, new { htmlAttributes = new { @class = "form-control" } })
                        <span class="input-group-addon">
                            <span class="calendar"></span>
                        </span>
                    </div>
                </div>
                @Html.HiddenFor(model => model.MinResultDate)

                <input type="submit" value="@Model.Today" class="btn btn-default btn-other-day" />
                <input type="submit" value="@Model.Yesterday" class="btn btn-default btn-other-day" />
                <input type="submit" value="@ResultLang.submit" class="btn btn-submit" />
            </div>

                <div class="col-sm-12">
                    <span class="txt-red">*</span> @Model.MinResultDateMessage
                </div>

            if (Model.Sports.Any())
            {
                <div class="col-sm-12 sport-info">
                    <span class="txt">@ResultLang.sport</span>
                    <div class="dropdown control">
                        @Html.DropDownListFor(model => model.SportId, Model.Sports, new { @class = "form-control", @onchange = "this.form.submit()" })
                    </div>

                    <span class="txt">@ResultLang.league</span>
                    <div class="dropdown control league-content">
                        @Html.DropDownListFor(model => model.LeagueId, Model.Leagues, ResultLang.ShowAllLeagues, new { @class = "form-control", @onchange = "this.form.submit()" })
                    </div>

                </div>
            }
        }



    </div>
    <div class="main-content">
        <div class="fn-rs-content-header">
            <table class="fn-rs">
                <thead>
                    <tr class="header">
                        <th class="">Kick Off. Time</th>
                        <th>Match</th>
                        <th class="">HT Score</th>
                        <th class="">Final Score</th>
                        <th class="">Status</th>
                    </tr>
                </thead>
            </table>
        </div>
        <div class="fn-rs-content-scroll">
            <table class="fn-rs">
                <tbody>
                    <tr class="data">
                        <td colspan="5" class="cl-league">Japan Empress women cup</td>
                    </tr>
                    <tr class="data odd">
                        <td rowspan="2">12/23/2015</td>
                        <td>NTV Beleza(W)(N)</td>
                        <td class="text-center">1</td>
                        <td class="text-center">-</td>
                        <td rowspan="2" class="text-center">Running</td>
                    </tr>
                    <tr class="data odd">
                        <td>Albirex Niigata (W)</td>
                        <td class="text-center">1</td>
                        <td class="text-center">-</td>
                    </tr>
                    <tr class="data">
                        <td colspan="5" class="cl-league">Japan Empress women cup-Corners</td>
                    </tr>
                    <tr class="data odd">
                        <td rowspan="2">12/23/2015</td>
                        <td>NTV Beleza(W)(N)</td>
                        <td class="text-center">1</td>
                        <td class="text-center">-</td>
                        <td rowspan="2" class="text-center">Completed</td>
                    </tr>
                    <tr class="data odd">
                        <td>Albirex Niigata (W)</td>
                        <td class="text-center">1</td>
                        <td class="text-center">-</td>
                    </tr>
                    <tr class="data even">
                        <td rowspan="2">12/23/2015</td>
                        <td>NTV Beleza(W)(N)</td>
                        <td class="text-center">1</td>
                        <td class="text-center">-</td>
                        <td rowspan="2" class="text-center">Completed</td>
                    </tr>
                    <tr class="data even">
                        <td>Albirex Niigata (W)</td>
                        <td class="text-center">1</td>
                        <td class="text-center">-</td>
                    </tr>
                    <tr class="data odd">
                        <td rowspan="2">12/23/2015</td>
                        <td>NTV Beleza(W)(N)</td>
                        <td class="text-center">1</td>
                        <td class="text-center">-</td>
                        <td rowspan="2" class="text-center">Completed</td>
                    </tr>
                    <tr class="data odd">
                        <td>Albirex Niigata (W)</td>
                        <td class="text-center">1</td>
                        <td class="text-center">-</td>
                    </tr>
                </tbody>
            </table>

        </div>
    </div>
</div>


@section scripts
{
    @Scripts.Render(BundleConfig.NormalResultJavascriptBundleUrl)
}

