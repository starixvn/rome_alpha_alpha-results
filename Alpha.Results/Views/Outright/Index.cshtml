
@{
    ViewBag.Title = "Outright";
}

@*@section Nav {
        @Html.Action("Index", "Tab", new { tabName = "outright" })
}*@


Outright
<div role="tabpanel" class="tab-pane active" id="outright">
    <div class="row filter">
        <div class="col-sm-12">
            <span class="txt">From</span>
            <div class="control">
                <div class="input-group date" id="datetimepicker_from">
                    <input type="text" class="form-control" />
                    <span class="input-group-addon">
                        <span class="calendar"></span>
                    </span>
                </div>
            </div>
            <span class="txt">To</span>
            <div class="control">
                <div class="input-group date" id="datetimepicker_to">
                    <input type="text" class="form-control" />
                    <span class="input-group-addon">
                        <span class="calendar"></span>
                    </span>
                </div>
            </div>
            <input type="button" value="12/23/2015" class="btn btn-default" />
            <input type="button" value="12/22/2015" class="btn btn-default" />
            <input type="button" value="Submit" class="btn btn-submit" />
        </div>
        <div class="col-sm-12">
            <span class="txt-red">*</span> You can view report data from 12/20/2015
        </div>
    </div>
</div>

