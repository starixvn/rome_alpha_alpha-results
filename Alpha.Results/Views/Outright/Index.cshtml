@{
    ViewBag.Title = "Outright";
}

@model OutrightViewModel
<div role="tabpanel" class="tab-pane active" id="outright">
    <div class="row filter">
        @using (Html.BeginForm("Index", "Outright", FormMethod.Get, new { id = "formOutright" }))
        {
            <div class="col-sm-12">
                <span class="txt">@ResultLang.from</span>
                <div class="control">
                    <div class="input-group date" id="dpkFromDate">
                        @Html.EditorFor(model => model.FromDate, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                        <span class="input-group-addon">
                            <span class="calendar"></span>
                        </span>
                    </div>
                </div>
                <span class="txt">@ResultLang.to</span>
                <div class="control">
                    <div class="input-group date" id="dpkToDate">
                        @Html.EditorFor(model => model.ToDate, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                        <span class="input-group-addon">
                            <span class="calendar"></span>
                        </span>
                    </div>
                </div>
                <input type="submit" value="@Model.Today" class="btn btn-default btn-other-day" />
                <input type="submit" value="@Model.Yesterday" class="btn btn-default btn-other-day" />
                <input type="submit" value="@ResultLang.submit" class="btn btn-submit" />
            </div>
            <div class="col-sm-12">
                <span class="txt-red">*</span> @Model.MinResultDateMessage
            </div>
            if (Model.Sports != null && Model.Sports.Count() > 0)
            {
                <div class="col-sm-12 sport-info">
                    <span class="txt">@ResultLang.sport</span>
                    <div class="dropdown control">
                        @Html.DropDownListFor(model => model.SportId, Model.Sports, new { @class = "form-control", @onchange = "this.form.submit()" })
                    </div>

                    <span class="txt">@ResultLang.league</span>
                    <div class="dropdown control league-content">
                        @Html.DropDownListFor(model => model.LeagueId, Model.Leagues, ResultLang.ShowAllLeagues, new { @class = "form-control", @onchange = "this.form.submit()" })
                    </div>
                </div>
            }
        }
    </div>
    <div class="main-content">
        @if (!string.IsNullOrEmpty(Model.HtmlResults))
        {
            @Html.Raw(Model.HtmlResults)
        }
        else
        {
            <div class="no-info">@ResultLang.ThereIsNoData</div>
        }
    </div>

    @Html.HiddenFor(model => model.MinResultDate)
    @Html.HiddenFor(model => model.MaxResultDate)
</div>

@section scripts
{
    @Scripts.Render(BundleConfig.OutrightResultJavascriptBundleUrl)
}