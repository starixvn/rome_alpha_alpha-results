@using Newtonsoft.Json;
@model HandHistoryResultViewModel
@{
    Layout = null;
}
<html>
<head>
    @Styles.Render(BundleConfig.HandHistoryResultStyleBundleUrl)
    <title>@Model.Title</title>
</head>
<body>
    <div id="handhistory-result"></div>
    @Html.Hidden("HandHistory", JsonConvert.SerializeObject(Model.HandHistory))
    @Alpha.Web.Helpers.StaticResources.AssetScripts.Render("/bundles/site-results/default")
    @Scripts.Render(BundleConfig.HandHistoryResultJavascriptBundleUrl)
</body>
</html>
