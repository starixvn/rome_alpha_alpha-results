@{
    ViewBag.Title = Model.ProductName;
}

@model LotteryResultViewModel

<div role="tabpanel" class="tab-pane active" id="lottery">
    <div class="filter">
        <a href="@(Model.ResultPath)" id="result-link" class="lnk" target="_blank">@Model.ResultLinkText</a>
        @Html.Hidden("extend-token-url", Model.ExtendTokenPath)
    </div>
</div>

@section scripts
{
    @Scripts.Render(BundleConfig.LotteryResultScriptBundleUrl)
}