@{
    ViewBag.Title = Model.ProductName;
}

@model VirtualGamesResultViewModel

<div role="tabpanel" class="tab-pane active" id="tabvirtualgames">
    <div class="filter">
        <a href="@(Model.ResultPath)" id="result-link" class="lnk" target="_blank">@Model.ResultLinkText</a>
    </div>
</div>

@section scripts
{
    @Scripts.Render(BundleConfig.VirtualGamesResultScriptBundleUrl)
}