@{
    ViewBag.Title = Resources.CockFighting;
    var cockFightingResult = Url.Action("Result", "Cockfighting");
}

<iframe id="iframeId" name='iframeId' frameborder="0" src="" left="0" top="0"></iframe>

@Html.Hidden("FailedToConnectMessage", @Resources.CockFightFailedToConnect)
@Html.Hidden("CockFightingResultUrl", @cockFightingResult)

@section scripts
{
    @Scripts.Render(BundleConfig.CockfightingResultJavascriptBundleUrl)
}
    
