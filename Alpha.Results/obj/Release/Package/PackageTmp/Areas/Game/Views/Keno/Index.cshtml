@using Alpha.Results.Site.App_GlobalResources

@{
    ViewBag.Title = Resources.Keno;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model Alpha.Results.Site.Models.Views.KenoViewModel
<div role="tabpanel" class="tab-pane active" id="keno">
    <div class="filter">
        @Html.ActionLink(
            Resources.OpenKenoResults,
            "index",
            "kenoresult",
            new { area = "game", date = Model.ResultDate, language = Model.LanguageKey, customerid = Model.CustomerId },
            new { id = "link-KenoResult", @class = "lnk", target = "_blank" })
    </div>
</div>

@section scripts
{
    <script type="text/javascript">
        (function () {
            var linkKenoResult = $('#link-KenoResult');
            var url = linkKenoResult.attr('href');

            linkKenoResult.click(function (e) {
                e.preventDefault();
                window.open(url, '_blank', 'width=900, height=700');
            });

            setTimeout(function () { window.open(url, '_blank', 'width=900, height=700'); }, 300);
        })();
    </script>
}

