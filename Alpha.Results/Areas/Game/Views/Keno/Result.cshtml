@using System.Threading

@{
    ViewBag.Title = "Keno";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var userSession = Sunplus.Agent.Model.Entities.UserSession.Current;
    Thread.CurrentThread.CurrentCulture = new System.Globalization.CultureInfo(userSession.Language);
    Thread.CurrentThread.CurrentUICulture = Thread.CurrentThread.CurrentCulture;

    var date = ViewBag.date;
    var language = ViewBag.language;
    var customerid = ViewBag.customerId;

    string rootUrl = HttpContext.Current.Response.ApplyAppPathModifier("~");
    string deailResultUrl = string.Format("{0}/game/keno/kenoresult/resultdetail?date={1}&language={2}&customerid={3}", rootUrl, date, language, customerid);
    string extendTokenUrl = rootUrl + "game/keno/kenoresult/extendtoken?userid=" + customerid;
}

<div role="tabpanel" class="tab-pane active" id="keno">
    <div class="row filter">
        <form ENCTYPE="multipart/form-data" id="target" action="@deailResultUrl" target="iframeId" method="POST"></form>
        <iframe id="iframeId" name="iframeId" frameborder="0" left="0" top="0" class="iframeKeno"></iframe>
    </div>
</div>

@section scripts
{
    <script type="text/javascript">
        (function () {
            function extendToken() {
                $.ajax({
                    type: 'POST',
                    url: '@extendTokenUrl',
                    contentType: 'application/json; charset=utf-8',
                    dataType: 'json',
                    success: function (rs) { },
                    error: function (e) { },
                    complete: function (e) { }
                });
            }

            function initialize() {
                $('#target').submit();
                setInterval(extendToken, 60 * 1000);
            }

            initialize();
        })();
    </script>
}
