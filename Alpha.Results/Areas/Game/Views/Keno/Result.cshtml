@using System.Threading
@using Fanex.Game.Keno.Resources
@{
    //Thread.CurrentThread.CurrentCulture = new System.Globalization.CultureInfo(Fanex.Razorbill.Module.ContextualCustomer.Utils.SessionExtension.Language);
    //Thread.CurrentThread.CurrentUICulture = Thread.CurrentThread.CurrentCulture;

    string rootUrl = Url.Content("~");
    string deailResultUrl = string.Format("{0}/game/keno/kenoresult/resultdetail?date={1}&language={2}&customerid={3}", rootUrl, ViewBag.date, ViewBag.language, ViewBag.customerId);
    string extendTokenUrl = rootUrl + "game/keno/kenoresult/extendtoken?userid=" + ViewBag.customerId;
}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@Message.Keno</title>
</head>
<body>
    <div>
        <form ENCTYPE="multipart/form-data" id="target" action="@deailResultUrl" target="iframeId" method="POST"></form>
        <iframe id="iframeId" name="iframeId" width="800px" height="580px" frameborder="0"
                style="overflow-x: hidden" left="0" top="0"></iframe>
    </div>

    <script type="text/javascript" src="/contents/libs/jquery/jquery-1.11.3.min.js"></script>
    <script type="text/javascript">
        (function () {
            function extendToken() {
                $.ajax({
                    type: 'POST',
                    url: '@extendTokenUrl',
                    contentType: 'application/json; charset=utf-8',
                    dataType: 'json',
                    success: function (rs) { },
                    error: function (e) { },
                    complete: function (e) { }
                });
            }

            function initialize() {
                $('#target').submit();
                setInterval(extendToken, 60 * 1000);
            }

            initialize();
        })();
    </script>
</body>
</html>