@using Alpha.Results.Site.App_GlobalResources

@{
    ViewBag.Title = Resources.Keno;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model Alpha.Results.Site.Models.Views.KenoViewModel
<div role="tabpanel" class="tab-pane active" id="keno">
    <div class="filter">
        <iframe width="100%" height="100%" frameborder="0" allowtransparency="yes" marginheight="0" marginwidth="0" name="main" scrolling="auto"
                src="@string.Format("{0}/game/keno/kenoresult/Index?date={1}&language={2}&customerid={3}",
                    @Url.Content("~/"), Model.ResultDate, Model.LanguageKey, Model.CustomerId)"></iframe>
    </div>
</div>
