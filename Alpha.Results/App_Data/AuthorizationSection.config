<?xml version="1.0" encoding="utf-8" ?>
<AuthorizationSection
  fullpermission="[A],[B],[C],[D],[E],[G],[H],[L]"
  custIdQueryStringParamNameMapping="custid,CustId,custId,AgentId"
  custIdJsonParamNameMapping="txtCustomerObject,newCustomer"
  ignoreUrls=""
  cachedExpireTime="30"
  kickOutUrl="~/default/kickout">
  <!--
    [A]: Create
    [B]: Update
    [C]: Transfer
    [D]: Total Bets
    [E]: Reports
    [F]: Forcast
    [H]: Member Information
    [G]: View Log
    [L]: Bet Lists
  -->
  <GroupPageAccess roleid="2" name="Agent">
    <PageAccesses>
      <add id="1.01.01" permission="" mainfuncname="Results" subfuncname="CardClub" url="CardClub" ischeckbelonging="true" isallowtodobythemselves="false" />
    </PageAccesses>
  </GroupPageAccess>

  <GroupPageAccess roleid="3" name="Master">
    <PageAccesses>
    </PageAccesses>
  </GroupPageAccess>

  <GroupPageAccess roleid="4" name="Super">
    <PageAccesses>
    </PageAccesses>
  </GroupPageAccess>
</AuthorizationSection>